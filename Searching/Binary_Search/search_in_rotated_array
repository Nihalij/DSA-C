#include <stdio.h>
int main() {
	int t;
	scanf("%d",&t);
	
	while(t--) {
	    int n;
	    scanf("%d",&n);
	    
	    int target;
	    scanf("%d",&target);
	    
	    int arr[n];
	    for(int i=0;i<n;i++) {
	        scanf("%d",&arr[i]);
	        
	    }
    	int low = 0;
    	int high = n-1;
    	int ans = -1;
	
	
    	while(low<=high) {
	         int mid = (low+high) /2;
	    
	    
	         if( arr[mid]==target) {
	              ans = mid;
	              break;
	         }
	    
	        if(arr[low] <= arr[mid]) {
	             if ( target >= arr[low] && target < arr[mid] ) {
	                 high = mid-1;
	                  } else {
	                  low = mid+1;
	             }
	             
	          }  else {
	               if(arr[mid]< target && arr[high] >= target) {
	                   low = mid+1;
	                  } else {
	                    high = mid-1;
	              }
            }
            
    	}
            printf("%d \n",ans);
        	} 
    return 0;
}

