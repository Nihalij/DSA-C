#include <stdio.h>

int main() {
	int n;
	scanf("%d",&n);
	int arr1[n] ,arr2[n];
	
	for(int i=0;i<n;i++) {
	    scanf("%d %d",&arr1[i],&arr2[i]);
	}
	
	int left,right;
	scanf("%d %d",&left,&right);
	
	
	
	for(int i=0;i<n;i++) {
	    int sum = arr1[i] +arr2[i];
	    int mul = arr1[i]*arr2[i];
	    
	    if (left<=sum && sum <=right && left<=mul && mul<=right) {
	        printf("%d %d ", arr1[i],arr2[i]);
	    }
	}
    return 0;
}

