struct Node* listReverse(struct Node* head) {
   
   struct Node* temp = head;
   struct Node* prev = NULL;
   struct Node* next = NULL;
   
   while(temp!=NULL) {
       next = temp->next;
       temp->next = prev;
       prev = temp;
       temp = next;
   }
   
   head = prev;
   return head;
}
